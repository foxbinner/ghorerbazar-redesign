# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase project URL (from Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (from Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — admin panel only, bypasses RLS (from Settings → API)
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# bKash and Nagad merchant numbers are managed via Admin → Settings (stored in Supabase site_settings table)
